@inject SimulationRunner Sim
<section class="card">
    <h2>Simulator settings</h2>
    <div class="row" style="gap: 18px">
        <label>Speed
            <select @bind="Speed">
                <option value="1000">slow (1 round/s)</option>
                <option value="400">normal</option>
                <option value="150">fast</option>
                <option value="20">as fast as possible</option>
            </select>
        </label>
        <label>Demand
            <span class="segmented">
                <button class="@(o.ParetoDemand ? "on" : "")" @onclick="() => o.ParetoDemand = true">Pareto (fast movers)</button>
                <button class="@(!o.ParetoDemand ? "on" : "")" @onclick="() => o.ParetoDemand = false">Flat</button>
            </span>
        </label>
        <label>No-read rate <input type="number" min="0" max="50" step="0.5" @bind="NoReadPct" /> %</label>
        <label>Lines per order ≤ <input type="number" min="1" max="8" @bind="o.MaxLinesPerOrder" /></label>
        <label>Pieces per line ≤ <input type="number" min="1" max="10" @bind="o.MaxQuantityPerLine" /></label>
        <label><input type="checkbox" @bind="o.GenerateOrders" /> generate orders (keep @o.QueueTarget queued)</label>
    </div>
</section>
@code {
    private Logistics.Wms.Application.Simulation.SimulationOptions o => Sim.State.Options;
    private int Speed { get => o.StepMilliseconds; set => o.StepMilliseconds = value; }
    private double NoReadPct { get => Math.Round(o.NoReadRate * 100, 2); set => o.NoReadRate = Math.Clamp(value, 0, 50) / 100; }
}
