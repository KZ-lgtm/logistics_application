@implements IAsyncDisposable
@inject TwinService Twin
@inject TwinBridge Bridge
@inject WmsClient Wms
@inject NavigationManager Nav
@inject IJSRuntime JS

@if (Twin.Started)
{
    <div class="live @(visible ? "" : "live-bg")" aria-hidden="@(!visible)">
        <header class="topbar">
            <h1 tabindex="-1">@L["Live 3D cell"]</h1>
            <span class="small muted twin-note">
                @L["The 3D cell is the WMS's cell controller. It works the orders on the put wall, the orders you create on the Orders page, as the WMS releases them, and books every pick, scan and sort. It keeps running while you use the other pages."]
            </span>
            <button class="danger" @onclick="Stop" title="@L["Stop the 3D cell (the WMS keeps its state; the round-based simulator or the console can continue)"]">@L["Stop 3D cell"]</button>
        </header>
        <div class="robot-bar" aria-label="@L["Robots"]">
            @foreach (var r in robots)
            {
                <div class="robot-chip @(r.State == RobotState.Fault ? "fault" : !r.Available ? "off" : "")">
                    <b>@r.Id</b>
                    <span class="small">@(r.State == RobotState.Fault ? L.F("fault {0}", r.FaultCode) : r.Mode != RobotMode.Auto ? L.Enum(r.Mode) : r.State == RobotState.Working ? L["working"] : L["idle"])</span>
                    @if (r.State == RobotState.Fault)
                    {
                        <button class="sm primary" @onclick="() => Clear(r)">@L["Clear"]</button>
                    }
                    else
                    {
                        <button class="sm danger" @onclick="() => Fault(r)" title="@L["Inject a fault: watch the WMS work around it"]">@L["Fault"]</button>
                    }
                    <select class="sm" value="@r.Mode" @onchange="e => Mode(r, e.Value?.ToString())" aria-label="@L.F("{0} mode", r.Id)">
                        @foreach (var m in Enum.GetValues<RobotMode>()) { <option value="@m">@L.Enum(m)</option> }
                    </select>
                </div>
            }
            <span class="spacer"></span>
            <a class="btn" href="orders">+ @L["New order"]</a>
        </div>
        <div class="twin-frame">
            @if (registered)
            {
                <iframe id="wms-twin" src="twin/index.html" title="@L["Live 3D cell driven by the WMS"]" allow="fullscreen"></iframe>
            }
        </div>
    </div>
}

@code {
    private DotNetObjectReference<TwinBridge>? reference;
    private bool registered, visible, reloadPending;
    private IReadOnlyList<RobotDto> robots = [];

    protected override void OnInitialized()
    {
        Twin.Changed += OnTwinChanged;
        Nav.LocationChanged += OnLocationChanged;
        Wms.Changed += OnWmsChanged;
        L.Changed += OnLanguageChanged;
        visible = OnLivePage();
    }

    private bool OnLivePage() => Nav.ToBaseRelativePath(Nav.Uri).Split('?', '#')[0].TrimEnd('/') == "live";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (Twin.Started && !registered)
        {
            reference ??= DotNetObjectReference.Create(Bridge);
            await JS.InvokeVoidAsync("wms.registerTwin", reference);
            registered = true;
            robots = await Wms.QueryAsync(sp => sp.Get<RobotService>().ListAsync());
            StateHasChanged();
        }
    }

    private void OnTwinChanged() => InvokeAsync(async () =>
    {
        if (!Twin.Started && registered)
        {
            registered = false;
            try { await JS.InvokeVoidAsync("wms.unregisterTwin"); } catch (JSDisconnectedException) { }
        }
        if (Twin.Started && registered) await JS.InvokeVoidAsync("wms.twinFocus", Twin.FocusOrderId);
        StateHasChanged();
    });

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e) => InvokeAsync(async () =>
    {
        visible = OnLivePage();
        if (registered) await JS.InvokeVoidAsync("wms.twinVisible", visible);
        StateHasChanged();
    });

    /// <summary>The robot bar refreshes at most once a second, and only while it is shown.</summary>
    private void OnWmsChanged()
    {
        if (!visible || !Twin.Started || reloadPending) return;
        reloadPending = true;
        _ = InvokeAsync(async () =>
        {
            await Task.Delay(1000);
            reloadPending = false;
            robots = await Wms.QueryAsync(sp => sp.Get<RobotService>().ListAsync());
            StateHasChanged();
        });
    }

    private void OnLanguageChanged() => InvokeAsync(async () =>
    {
        if (registered) await JS.InvokeVoidAsync("wms.twinCall", "wmsTwinLang", L.IsChinese ? "zh" : "en");
        StateHasChanged();
    });

    private void Stop()
    {
        Twin.Stop();
        Nav.NavigateTo("");
    }

    private static string FaultCode(RobotDto r) => r.Role switch { RobotRole.ShelfRobot => "50056", RobotRole.Picker => "VAC-01", _ => "E-417" };

    private Task Fault(RobotDto r) => Wms.CommandAsync(sp => sp.Get<RobotService>().ReportFaultAsync(r.Id,
        new RobotFaultRequest(FaultCode(r), r.Role switch { RobotRole.ShelfRobot => "joint collision", RobotRole.Picker => "vacuum lost", _ => "cup worn" }, "live view")),
        L.F("{0}: fault injected. The WMS works around it.", r.Id));

    private Task Clear(RobotDto r) => Wms.CommandAsync(sp => sp.Get<RobotService>().ClearFaultAsync(r.Id, "live view"), L.F("{0}: fault cleared.", r.Id));

    private Task Mode(RobotDto r, string? mode) =>
        Enum.TryParse<RobotMode>(mode, out var m) ? Wms.CommandAsync(sp => sp.Get<RobotService>().SetModeAsync(r.Id, new SetRobotModeRequest(m, "live view")), L.F("{0} → {1}.", r.Id, L.Enum(m))) : Task.CompletedTask;

    public async ValueTask DisposeAsync()
    {
        Twin.Changed -= OnTwinChanged;
        Nav.LocationChanged -= OnLocationChanged;
        Wms.Changed -= OnWmsChanged;
        L.Changed -= OnLanguageChanged;
        try { await JS.InvokeVoidAsync("wms.unregisterTwin"); } catch (JSDisconnectedException) { }
        reference?.Dispose();
    }
}
