<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
    <BlazorWebAssemblyLoadAllGlobalizationData>false</BlazorWebAssemblyLoadAllGlobalizationData>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- GitHub Pages compresses on the fly and never serves pre-compressed .br / .gz files -->
    <CompressionEnabled>false</CompressionEnabled>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.14" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.14" PrivateAssets="all" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.14" />
  </ItemGroup>

  <!-- the 3D cell engine, robot models and kinematics come unchanged from the cell simulation (simulation/canvas/project) -->
  <ItemGroup>
    <Content Include="..\..\simulation\canvas\project\three.min.js;..\..\simulation\canvas\project\robot_glb.js;..\..\simulation\canvas\project\station_ui.js;..\..\simulation\canvas\project\app.js"
             Link="wwwroot\twin\cell\%(Filename)%(Extension)" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Logistics.Wms.Application\Logistics.Wms.Application.csproj" />
    <ProjectReference Include="..\Logistics.Wms.Persistence\Logistics.Wms.Persistence.csproj" />
  </ItemGroup>

</Project>
