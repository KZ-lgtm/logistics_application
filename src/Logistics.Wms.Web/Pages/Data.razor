@page "/data"
@implements IDisposable
@inject BrowserStore Store
@inject WmsClient Wms
@inject SimulationRunner Sim
@inject Notifications Notifications
@inject IJSRuntime JS
<PageTitle>@L["Data & storage · Logistics WMS"]</PageTitle>
<PageHeader Title="@L["Data & storage"]" />

<div class="content">
    <div class="grid">
        <section class="card span-6 stack">
            <h2>@L["This browser"]</h2>
            <p class="muted" style="margin: 0">
                @L["The WMS keeps its database in memory and saves it to this browser's local storage a few seconds after every change. Nothing is sent to a server. Other browsers and devices have their own, separate cell."]
            </p>
            <table>
                <tbody>
                    <tr><td>@L["Last saved"]</td><td class="r">@(Store.LastSaved is null ? L["not yet"] : Fmt.Time(Store.LastSaved))</td></tr>
                    <tr><td>@L["Snapshot size"]</td><td class="r">@Fmt.Bytes(Store.LastSize)</td></tr>
                    <tr><td>@L["Last save took"]</td><td class="r">@Store.LastSaveMs.ToString("F0") ms</td></tr>
                    <tr><td>@L["Local storage used by this site"]</td><td class="r">@Fmt.Bytes(used)</td></tr>
                </tbody>
            </table>
            <div class="row">
                <button class="primary" disabled="@busy" @onclick="Save">@L["Save now"]</button>
                <button disabled="@busy" @onclick="Compact">@L["Compact history"]</button>
            </div>
            <p class="small muted" style="margin: 0">
                @L["Compaction keeps the newest 300 finished orders and 2,000 ledger bookings. Older bookings are folded into one opening balance per bin, so stock stays exact, and lifetime totals on the dashboard are kept. It runs automatically once there are more than 600 orders, which keeps the cell fast and the snapshot well within local storage."]
            </p>
        </section>

        <section class="card span-6 stack">
            <h2>@L["Backup & restore"]</h2>
            <p class="muted" style="margin: 0">@L["Export the complete WMS state as a JSON file, or load one exported earlier, for example from another browser. Loading replaces the current state."]</p>
            <div class="row">
                <button disabled="@busy" @onclick="Export">@L["Export JSON"]</button>
                <label class="btn" style="color: var(--text)">
                    @L["Import JSON…"]
                    <InputFile accept=".json,application/json" OnChange="Import" style="display: none" />
                </label>
            </div>
            <h2 style="margin-top: 10px">@L["Start over"]</h2>
            <p class="muted" style="margin: 0">@L["Back to the initial cell: 40 SKUs, 120 bins with the seeded stock, no orders."]</p>
            <div class="row">
                @if (confirmReset)
                {
                    <span class="warn">@L["All orders, bookings and changes in this browser will be deleted."]</span>
                    <button class="danger" @onclick="Reset">@L["Yes, reset the cell"]</button>
                    <button class="ghost" @onclick="() => confirmReset = false">@L["Keep"]</button>
                }
                else
                {
                    <button class="danger" @onclick="() => confirmReset = true">@L["Reset cell…"]</button>
                }
            </div>
        </section>

        <section class="card span-12">
            <h2>@L["About this edition"]</h2>
            <p style="margin-top: 0">
                @L["This is the browser edition of the Logistics WMS. It runs the same C# domain model and WMS services as the ASP.NET Core server edition (src/Logistics.Wms.Application), compiled to WebAssembly with Blazor. The difference is the database: here EF Core's in-memory provider, saved to local storage; on the server, SQLite. It is meant for demonstration, training and process studies. A real cell connects to the server edition's HTTP API."]
            </p>
            <p class="muted" style="margin-bottom: 0">
                @L["Source and documentation:"] <a href="https://github.com/KZ-lgtm/logistics_application">github.com/KZ-lgtm/logistics_application</a> ·
                @L["the 3D cell simulation:"] <a href="../simulation/robot_cell.html">robot_cell.html</a>
            </p>
        </section>
    </div>
</div>

@code {
    private const long MaxImport = 30 * 1024 * 1024;
    private bool busy, confirmReset;
    private long used;

    protected override async Task OnInitializedAsync()
    {
        Wms.Changed += Refresh;
        await Measure();
    }

    private async Task Measure()
    {
        try { used = await JS.InvokeAsync<long>("wms.storageEstimate"); } catch (JSException) { used = 0; }
    }

    private void Refresh() => InvokeAsync(async () => { await Measure(); StateHasChanged(); });

    private async Task Save()
    {
        busy = true;
        await Store.SaveAsync();
        await Measure();
        Notifications.Info(Store.Warning ?? L.F("Saved ({0}).", Fmt.Bytes(Store.LastSize)));
        busy = false;
    }

    private async Task Compact()
    {
        busy = true;
        var r = await Store.CompactAsync();
        await Store.SaveAsync();
        await Measure();
        Notifications.Info(L.F("Compacted: {0} orders, {1} pick tasks and {2} R1 tasks archived, {3} bookings folded into {4} opening balances.", r.OrdersRemoved, r.PickTasksRemoved, r.AsrsTasksRemoved, r.TransactionsFolded, r.OpeningBalances));
        busy = false;
    }

    private async Task Export()
    {
        busy = true;
        var json = await Store.ExportAsync();
        await JS.InvokeVoidAsync("wms.download", $"logistics-wms-{DateTime.Now:yyyyMMdd-HHmmss}.json", json, "application/json");
        busy = false;
    }

    private async Task Import(InputFileChangeEventArgs e)
    {
        busy = true;
        try
        {
            Sim.Stop();
            using var reader = new StreamReader(e.File.OpenReadStream(MaxImport));
            await Store.RestoreAsync(await reader.ReadToEndAsync());
            await Store.SaveAsync();
            Notifications.Info(L.F("Loaded {0}.", e.File.Name));
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            Notifications.Error(L.F("{0} could not be loaded: {1}", e.File.Name, L.Message(ex.Message)));
        }
        await Measure();
        busy = false;
    }

    private async Task Reset()
    {
        confirmReset = false;
        Sim.Stop();
        await Store.ResetAsync();
        await Store.SaveAsync();
        Notifications.Info(L["The cell was reset to its initial stock."]);
    }

    public void Dispose() => Wms.Changed -= Refresh;
}
