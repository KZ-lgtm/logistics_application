@page "/inventory"
@inherits WmsPage
<PageTitle>@L["Inventory · Logistics WMS"]</PageTitle>
<PageHeader Title="@L["Inventory"]" />

<div class="content">
    <section class="card">
        <div class="tabs">
            <button class="@(tab == Tab.Stock ? "on" : "")" @onclick="() => Show(Tab.Stock)">@L["Stock per SKU"]</button>
            <button class="@(tab == Tab.Bins ? "on" : "")" @onclick="() => Show(Tab.Bins)">@L["Bins"]</button>
            <button class="@(tab == Tab.Ledger ? "on" : "")" @onclick="() => Show(Tab.Ledger)">@L["Stock ledger"]</button>
        </div>

        @switch (tab)
        {
            case Tab.Stock:
                <div class="row" style="margin-bottom: 10px">
                    <input placeholder="@L["Filter SKU or name"]" @bind="skuFilter" @bind:event="oninput" />
                    <label><input type="checkbox" @bind="lowOnly" /> @L["at or below reorder point"]</label>
                    <span class="spacer"></span>
                    <span class="muted small">@L.F("{0} cartons in {1} bins", stock.Sum(s => s.Total), stock.Sum(s => s.Bins))</span>
                </div>
                <div class="table-wrap tall">
                    <table>
                        <thead><tr><th>@L["SKU"]</th><th>@L["Name"]</th><th>@L["Size"]</th><th class="r">@L["Bin cap."]</th><th class="r">@L["Bins"]</th><th class="r">@L["In shelf"]</th><th class="r">@L["On loops"]</th><th class="r">@L["Exc. buffer"]</th><th class="r">@L["Total"]</th><th class="r">@L["Pending picks"]</th><th class="r">@L["Open demand"]</th><th class="r">@L["Reorder pt."]</th><th></th></tr></thead>
                        <tbody>
                            @foreach (var s in FilteredStock)
                            {
                                <tr>
                                    <td>@s.Code</td><td>@L.Message(s.Name)</td><td>@s.Size</td><td class="r">@s.BinCapacity</td><td class="r">@s.Bins</td>
                                    <td class="r">@s.InRack</td><td class="r">@s.OnLoops</td><td class="r">@s.RestockBuffer</td>
                                    <td class="r @(s.LowStock ? "warn" : "")">@s.Total</td><td class="r">@s.PendingPicks</td><td class="r">@s.OpenDemand</td><td class="r">@s.ReorderPoint</td>
                                    <td><button class="sm ghost" @onclick="() => ShowBins(s.Code)">@L["bins →"]</button></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <h2 style="margin-top: 16px">@L["New SKU"]</h2>
                <div class="form-grid">
                    <div class="field"><span>@L["Code (bar code)"]</span><input @bind="newSku.Code" placeholder="SKU-1041" /></div>
                    <div class="field"><span>@L["Name"]</span><input @bind="newSku.Name" /></div>
                    <div class="field"><span>@L["Carton size"]</span>
                        <select @bind="newSku.Size">
                            @foreach (var z in Enum.GetValues<SkuSize>()) { <option value="@z">@z · @L.F("{0} per bin", CellLayout.BinCapacity(z))</option> }
                        </select>
                    </div>
                    <div class="field"><span>@L["Weight (kg, ≤ 2)"]</span><input type="number" step="0.05" @bind="newSku.WeightKg" /></div>
                    <div class="field"><span>@L["Reorder point"]</span><input type="number" min="0" @bind="newSku.ReorderPoint" /></div>
                    <div><button class="primary" @onclick="CreateSku">@L["Create SKU"]</button></div>
                </div>
                <p class="small muted">@L["A new SKU gets stock when the restock operator gives it an empty bin (Cell operations → restock)."]</p>
                break;

            case Tab.Bins:
                <div class="row" style="margin-bottom: 10px">
                    <input placeholder="@L["SKU code"]" @bind="binSku" @bind:after="LoadAsync" />
                    <select @bind="binLocation" @bind:after="LoadAsync">
                        <option value="">@L["all locations"]</option>
                        @foreach (var l in Enum.GetValues<BinLocation>()) { <option value="@l">@Fmt.Location(l)</option> }
                    </select>
                    <span class="spacer"></span>
                    <span class="muted small">@L.F("{0} bins", bins.Count)</span>
                </div>
                <div class="table-wrap tall">
                    <table>
                        <thead><tr><th>@L["Bin"]</th><th>@L["SKU"]</th><th class="r">@L["Qty"]</th><th class="r">@L["Cap."]</th><th>@L["Location"]</th><th>@L["Slot"]</th><th>@L["Last moved"]</th><th>@L["Cycle count"]</th></tr></thead>
                        <tbody>
                            @foreach (var b in bins)
                            {
                                var countable = (b.Location == BinLocation.Rack && !b.Reserved) || b.Location == BinLocation.RestockStation;
                                <tr>
                                    <td>@b.Id</td><td>@b.SkuCode</td>
                                    <td class="r">@b.Quantity</td><td class="r">@b.Capacity</td>
                                    <td><StatusPill Value="b.Location" Label="@(Fmt.Location(b.Location) + (b.Station is null ? "" : " " + b.Station) + (b.Reserved ? " · " + L["R1 task"] : ""))" /></td>
                                    <td>@b.Slot</td>
                                    <td class="muted">@Fmt.Time(b.LastMovedAt)</td>
                                    <td>
                                        @if (countable)
                                        {
                                            <span class="row" style="gap: 4px">
                                                <input type="number" min="0" max="@b.Capacity" value="@b.Quantity" @onchange="e => counted[b.Id] = int.TryParse(e.Value?.ToString(), out var v) ? v : b.Quantity" />
                                                <button class="sm" @onclick="() => Adjust(b)">@L["Book"]</button>
                                            </span>
                                        }
                                        else { <span class="muted small">@L["moving"]</span> }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                break;

            case Tab.Ledger:
                <div class="row" style="margin-bottom: 10px">
                    <input placeholder="@L["SKU code"]" @bind="ledgerSku" @bind:after="LoadAsync" />
                    <input placeholder="@L["Bin"]" @bind="ledgerBin" @bind:after="LoadAsync" />
                    <span class="spacer"></span>
                    <span class="muted small">@L["newest 300 bookings · sum of all bookings = stock"]</span>
                </div>
                <div class="table-wrap tall">
                    <table>
                        <thead><tr><th>#</th><th>@L["Time"]</th><th>@L["Type"]</th><th>@L["SKU"]</th><th>@L["Bin"]</th><th class="r">@L["Qty"]</th><th class="r">@L["Bin after"]</th><th>@L["Reference"]</th><th>@L["User"]</th></tr></thead>
                        <tbody>
                            @foreach (var t in ledger)
                            {
                                <tr>
                                    <td class="muted">@t.Id</td><td>@Fmt.Time(t.At)</td><td>@L.Enum(t.Type)</td><td>@t.SkuCode</td><td>@t.BinId</td>
                                    <td class="r @(t.Quantity < 0 ? "bad" : t.Quantity > 0 ? "ok" : "")">@t.Quantity.ToString("+0;-0;0")</td>
                                    <td class="r">@t.BinQuantityAfter</td><td class="muted wrap">@L.Message(t.Reference ?? "")</td><td class="muted">@t.User</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                break;
        }
    </section>
</div>

@code {
    private enum Tab { Stock, Bins, Ledger }
    private sealed class NewSku { public string Code { get; set; } = ""; public string Name { get; set; } = ""; public SkuSize Size { get; set; } = SkuSize.M; public double WeightKg { get; set; } = 0.5; public int ReorderPoint { get; set; } = 6; }

    private Tab tab;
    private IReadOnlyList<SkuStockDto> stock = [];
    private IReadOnlyList<BinDto> bins = [];
    private IReadOnlyList<InventoryTransactionDto> ledger = [];
    private string skuFilter = "";
    private bool lowOnly;
    private string? binSku;
    private BinLocation? binLocation;
    private string? ledgerSku, ledgerBin;
    private NewSku newSku = new();
    private readonly Dictionary<string, int> counted = [];

    protected override TimeSpan Throttle => TimeSpan.FromSeconds(1.5);

    private IEnumerable<SkuStockDto> FilteredStock => stock
        .Where(s => !lowOnly || s.LowStock)
        .Where(s => skuFilter.Length == 0 || s.Code.Contains(skuFilter, StringComparison.OrdinalIgnoreCase) || s.Name.Contains(skuFilter, StringComparison.OrdinalIgnoreCase) || L.Message(s.Name).Contains(skuFilter, StringComparison.OrdinalIgnoreCase));

    protected override async Task LoadAsync()
    {
        switch (tab)
        {
            case Tab.Stock: stock = await Wms.QueryAsync(sp => sp.Get<InventoryService>().GetStockAsync()); break;
            case Tab.Bins: bins = await Wms.QueryAsync(sp => sp.Get<InventoryService>().ListBinsAsync(binSku, binLocation)); break;
            case Tab.Ledger: ledger = await Wms.QueryAsync(sp => sp.Get<InventoryService>().ListTransactionsAsync(ledgerSku, ledgerBin, 300)); break;
        }
    }

    private async Task Show(Tab t)
    {
        tab = t;
        await LoadAsync();
    }

    private async Task ShowBins(string sku)
    {
        binSku = sku;
        binLocation = null;
        await Show(Tab.Bins);
    }

    private async Task Adjust(BinDto b)
    {
        var qty = counted.GetValueOrDefault(b.Id, b.Quantity);
        await Wms.CommandAsync(sp => sp.Get<InventoryService>().AdjustBinAsync(b.Id, new AdjustBinRequest(qty, "cycle count", "console")),
            qty == b.Quantity ? L.F("Bin {0}: count confirmed ({1}).", b.Id, qty) : L.F("Bin {0}: {1} → {2} booked.", b.Id, b.Quantity, qty));
        counted.Remove(b.Id);
        await LoadAsync();
    }

    private async Task CreateSku()
    {
        var r = new CreateSkuRequest(newSku.Code, newSku.Name, newSku.Size, newSku.WeightKg, newSku.ReorderPoint);
        if (await Wms.CommandAsync(sp => sp.Get<InventoryService>().CreateSkuAsync(r), L.F("SKU {0} created.", newSku.Code.Trim().ToUpperInvariant())) is not null)
            newSku = new();
        await LoadAsync();
    }
}
