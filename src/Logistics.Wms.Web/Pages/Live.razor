@page "/live"
@inject TwinService Twin
<PageTitle>@L["Live 3D cell · Logistics WMS"]</PageTitle>
@* The 3D cell itself is in the layout (TwinHost), so it keeps running on the other pages; this page starts it and shows it. *@

@code {
    [SupplyParameterFromQuery(Name = "order")] public int? Order { get; set; }

    protected override void OnParametersSet()
    {
        Twin.Start();
        Twin.Focus(Order);
    }
}
