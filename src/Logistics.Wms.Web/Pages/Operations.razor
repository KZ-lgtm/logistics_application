@page "/operations"
@inherits WmsPage
@inject SimulationRunner Sim
<PageTitle>Cell operations · Logistics WMS</PageTitle>
<PageHeader Title="Cell operations" />

<div class="content">
    <p class="muted" style="margin: 0">
        This console plays the cell controller and the operators by hand: every button is one WMS call, the same calls the cell (or the simulator)
        makes. Work through the flow from left to right: R1 → picking loop → stops → belt &amp; arch → sorters → put wall.
        @if (Sim.Running) { <span class="warn">The simulator is running and will act on the same items. Stop it to work by hand.</span> }
    </p>
    @if (Sim.TwinActive)
    {
        <div class="banner">The live 3D cell is the cell controller now: it books these events itself, so the buttons here are locked. <a href="live">Go to the 3D cell</a> or stop it there to work by hand.</div>
    }

    <fieldset class="ops" disabled="@Sim.TwinActive">
    <div class="grid">
        <!-- R1 -->
        <section class="card span-4 stack">
            <h2>1 · R1 in the cylinder shelf</h2>
            @if (task is { } t)
            {
                <div class="task">
                    <b>@t.Kind.Words()</b> · bin @t.BinId <span class="muted">(@t.SkuCode, @t.BinQuantity pcs)</span>
                    <div class="small muted">@t.From → @t.To</div>
                </div>
                <div class="row">
                    <button class="primary" @onclick="() => CompleteTask(t)">Task done</button>
                    <button class="danger" @onclick="() => CancelTask(t)">Cancel task</button>
                </div>
            }
            else
            {
                <div class="muted">R1 has no task.</div>
                <div><button class="primary" @onclick="NextTask">Request next task</button></div>
            }
            <div class="small muted">Order of work: returning bins, refilled bins, retrievals for open demand, empty bins to restock.</div>
        </section>

        <!-- picking loop -->
        <section class="card span-4 stack">
            <h2>2 · Picking loop</h2>
            @if (inbound.Count == 0)
            {
                <div class="empty">No bin on the way to a stop.</div>
            }
            @foreach (var b in inbound)
            {
                <div class="stop row">
                    <span><b>@b.Id</b> · @b.SkuCode · @b.Quantity pcs</span>
                    <span class="spacer"></span>
                    @if (b.Station is null)
                    {
                        <button @onclick="() => Route(b.Id)">Decision point</button>
                    }
                    else
                    {
                        <span class="pill s-AtStation">→ @b.Station</span>
                        <button class="primary" disabled="@(stations.Any(s => s.Station == b.Station && s.BinId is not null))" @onclick="() => Arrive(b.Id, b.Station.Value)">Arrived</button>
                    }
                </div>
            }
            <div class="small muted">At the decision point the WMS sends the bin to P2, else P1, or back if its SKU is no longer needed.</div>
        </section>

        <!-- stops -->
        <section class="card span-4 stack">
            <h2>3 · Picking stops (R2 / R3)</h2>
            @foreach (var st in stations)
            {
                <div class="stop stack">
                    <div class="row"><b>@st.Station</b>
                        @if (st.BinId is null) { <span class="muted">no bin</span> }
                        else { <span>bin @st.BinId · @st.SkuCode · <b>@st.BinQuantity</b> pcs</span> }
                    </div>
                    @if (st.BinId is not null)
                    {
                        @foreach (var p in st.Picks.Take(4))
                        {
                            <div class="row small">
                                <span>#@p.Sequence → order @p.OrderId <span class="muted">(@p.OrderReference)</span></span>
                                <span class="spacer"></span>
                                @if (p == st.Picks[0])
                                {
                                    <button class="sm primary" @onclick="() => Do(sp => sp.Get<PickingService>().ConfirmPickAsync(p.PickTaskId), null)">Picked onto belt</button>
                                }
                            </div>
                        }
                        @if (st.Picks.Count > 4) { <div class="small muted">… @(st.Picks.Count - 4) more</div> }
                        <div class="row small">
                            <span class="muted">3D image counts</span>
                            <input type="number" min="0" @bind="counts[st.Station]" />
                            <button class="sm" @onclick="() => Count(st)">Correct count</button>
                        </div>
                    }
                </div>
            }
        </section>

        <!-- belt -->
        <section class="card span-6">
            <div class="card-head"><h2>4 · Item belt, bar-code arch, sorters (S1 / S2)</h2><span class="muted small">@belt.Count on the belt</span></div>
            @if (belt.Count == 0)
            {
                <div class="empty">The belt is empty.</div>
            }
            else
            {
                <div class="table-wrap" style="max-height: 320px">
                    <table>
                        <thead><tr><th>Carton</th><th>SKU</th><th>Order</th><th>Status</th><th></th></tr></thead>
                        <tbody>
                            @foreach (var i in belt)
                            {
                                <tr>
                                    <td>#@i.PickTaskId</td>
                                    <td>@i.SkuCode</td>
                                    <td>@i.OrderId</td>
                                    <td>@if (i.Status == PickStatus.Routed) { <span class="pill s-Routed">→ @i.TargetSorter · @i.TargetLaneId</span> } else { <span class="pill s-Pending">not scanned</span> }</td>
                                    <td class="r">
                                        @if (i.Status == PickStatus.OnBelt)
                                        {
                                            <button class="sm primary" @onclick="() => Scan(i, i.SkuCode)">Scan</button>
                                            <button class="sm" @onclick="() => Scan(i, null)" title="The arch could not read the bar code">No read</button>
                                            <button class="sm" @onclick="() => Scan(i, WrongCode(i.SkuCode))" title="The arch read another SKU's bar code">Wrong code</button>
                                        }
                                        else
                                        {
                                            <button class="sm primary" @onclick="() => Sort(i)">Put into @i.TargetLaneId</button>
                                            <button class="sm" @onclick="() => Missed(i)" title="The sorter did not take it: it runs off the belt into the exception tote">Missed</button>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>

        <!-- put wall -->
        <section class="card span-6">
            <h2>5 · Put wall &amp; packing operator</h2>
            <div class="lanes">
                @foreach (var l in lanes)
                {
                    <div class="lane">
                        <div class="head">@l.Id <StatusPill Value="l.State" Label="@(l.Disabled ? "disabled" : null)" /></div>
                        <div class="muted small">@(l.OrderId is null ? "no order" : $"order {l.OrderId} · {l.SortedItems}/{l.OrderItems}")</div>
                        @switch (l.State)
                        {
                            case LaneState.Outbound: <button class="sm primary" @onclick="() => Lane(l, LaneEvent.CaseAtOperator)">At operator</button> break;
                            case LaneState.AtOperator: <button class="sm primary" @onclick="() => Lane(l, LaneEvent.CaseReplaced)">Packed, new case</button> break;
                            case LaneState.Inbound: <button class="sm primary" @onclick="() => Lane(l, LaneEvent.EmptyCaseInPosition)">Case in place</button> break;
                            default:
                                <button class="sm ghost" @onclick="() => ToggleLane(l)">@(l.Disabled ? "Enable" : "Disable")</button>
                                break;
                        }
                    </div>
                }
            </div>
        </section>

        <!-- restock -->
        <section class="card span-6 stack">
            <h2>6 · Restock operator (west port)</h2>
            @if (restock.Count == 0)
            {
                <div class="empty">No bin at the restock station. R1 sends empty bins here.</div>
            }
            @foreach (var r in restock)
            {
                var f = Refill(r.BinId, r);
                <div class="stop row">
                    <span><b>@r.BinId</b> · @r.SkuCode · @r.Quantity / @r.Capacity pcs @if (r.BufferAvailable > 0) { <span class="pill s-Open">@r.BufferAvailable from exceptions</span> }</span>
                    <span class="spacer"></span>
                    <label class="small">fill to <input type="number" min="0" @bind="f.Quantity" /></label>
                    @if (r.Quantity == 0)
                    {
                        <select class="small" @bind="f.Sku" title="An empty bin can take another SKU">
                            @foreach (var s in skus) { <option value="@s.Code">@s.Code</option> }
                        </select>
                    }
                    <button class="sm primary" @onclick="() => DoRestock(r, f)">Done</button>
                </div>
            }
        </section>

        <!-- exceptions -->
        <section class="card span-6 stack">
            <div class="card-head">
                <h2>7 · Exception tote</h2>
                <button class="sm" @onclick="EmptyTote">Tote emptied</button>
            </div>
            @if (exceptions.Count == 0)
            {
                <div class="empty">No open exceptions.</div>
            }
            else
            {
                <div class="table-wrap" style="max-height: 260px">
                    <table>
                        <thead><tr><th>#</th><th>SKU</th><th>Order</th><th>Reason</th><th></th></tr></thead>
                        <tbody>
                            @foreach (var e in exceptions)
                            {
                                <tr>
                                    <td>@e.Id</td><td>@e.SkuCode</td><td>@e.OrderId</td>
                                    <td>@e.Reason.Words() @if (e.ReadBarcode is not null) { <span class="muted">(read @e.ReadBarcode)</span> }</td>
                                    <td class="r">
                                        <button class="sm" @onclick="() => Resolve(e, ExceptionDisposition.ReturnedToStock)">Return to stock</button>
                                        <button class="sm danger" @onclick="() => Resolve(e, ExceptionDisposition.Scrapped)">Scrap</button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>
    </div>
    </fieldset>
</div>

@code {
    private sealed class RefillForm { public int Quantity { get; set; } public string Sku { get; set; } = ""; }

    private AsrsTaskDto? task;
    private IReadOnlyList<BinDto> inbound = [];
    private IReadOnlyList<StationDto> stations = [];
    private IReadOnlyList<BeltItemDto> belt = [];
    private IReadOnlyList<LaneDto> lanes = [];
    private IReadOnlyList<RestockBinDto> restock = [];
    private IReadOnlyList<ExceptionItemDto> exceptions = [];
    private IReadOnlyList<SkuStockDto> skus = [];
    private readonly Dictionary<PickStation, int> counts = new() { [PickStation.P1] = 0, [PickStation.P2] = 0 };
    private readonly Dictionary<string, RefillForm> refills = [];

    protected override async Task OnInitializedAsync()
    {
        skus = await Wms.QueryAsync(sp => sp.Get<InventoryService>().GetStockAsync());
        await base.OnInitializedAsync();
    }

    protected override async Task LoadAsync()
    {
        (task, inbound, stations, belt, lanes, restock, exceptions) = await Wms.QueryAsync(async sp => (
            await sp.Get<AsrsService>().GetCurrentTaskAsync(),
            await sp.Get<InventoryService>().ListBinsAsync(null, BinLocation.PickInbound),
            (IReadOnlyList<StationDto>)[await sp.Get<PickingService>().GetStationAsync(PickStation.P1), await sp.Get<PickingService>().GetStationAsync(PickStation.P2)],
            await sp.Get<SortationService>().ListOnBeltAsync(),
            await sp.Get<PutWallService>().ListAsync(),
            await sp.Get<RestockService>().ListAsync(),
            await sp.Get<ExceptionService>().ListAsync(openOnly: true, take: 100)));
        foreach (var st in stations)
            if (st.BinId is not null && !countsFor.Contains($"{st.Station}:{st.BinId}")) { counts[st.Station] = st.BinQuantity; countsFor.Add($"{st.Station}:{st.BinId}"); }
    }

    private readonly HashSet<string> countsFor = [];

    private async Task Do<T>(Func<IServiceProvider, Task<T>> command, string? success)
    {
        await Wms.CommandAsync(command, success);
        await LoadAsync();
    }

    private async Task NextTask()
    {
        var t = await Wms.CommandAsync(sp => sp.Get<AsrsService>().RequestNextTaskAsync());
        if (t is null) Notifications.Info("R1 has nothing to do: no returning bin, no open demand, no empty bin to restock.");
        await LoadAsync();
    }

    private async Task Route(string binId)
    {
        var r = await Wms.CommandAsync(sp => sp.Get<PickingService>().RouteBinAsync(binId));
        if (r is not null)
            Notifications.Info(r.Decision switch
            {
                RouteDecision.Station => $"Bin {binId} → stop {r.Station} ({r.OpenDemand} pcs open demand).",
                RouteDecision.Return => $"Bin {binId} is not needed any more and goes back to the return head.",
                _ => $"Both stops are busy: bin {binId} waits at the decision point.",
            });
        await LoadAsync();
    }

    private async Task Arrive(string binId, PickStation station)
    {
        var st = await Wms.CommandAsync(sp => sp.Get<PickingService>().ArriveAtStationAsync(binId, station));
        if (st is not null)
            Notifications.Info(st.BinId is null ? $"Bin {binId} has nothing to pick any more and was released." : $"Bin {binId} at {station}: {st.Picks.Count} picks allocated.");
        await LoadAsync();
    }

    private Task Count(StationDto st) =>
        Do(sp => sp.Get<PickingService>().ReportBinCountAsync(st.BinId!, new BinCountRequest(counts[st.Station], "console")), $"Bin {st.BinId} corrected to {counts[st.Station]} pcs.");

    private async Task Scan(BeltItemDto i, string? barcode)
    {
        var r = await Wms.CommandAsync(sp => sp.Get<SortationService>().ScanAsync(new ScanRequest(i.PickTaskId, barcode)));
        if (r is not null)
        {
            if (r.Target == ScanTarget.Exception) Notifications.Error($"Carton #{i.PickTaskId} → exception tote ({r.ExceptionReason?.Words()}); the order line is fetched again.");
            else Notifications.Info($"Carton #{i.PickTaskId} → {r.Target}, lane {r.LaneId}.");
        }
        await LoadAsync();
    }

    private string WrongCode(string code) => skus.FirstOrDefault(s => s.Code != code)?.Code ?? "SKU-0000";

    private async Task Sort(BeltItemDto i)
    {
        var r = await Wms.CommandAsync(sp => sp.Get<SortationService>().ConfirmSortAsync(new SortConfirmRequest(i.PickTaskId, i.TargetLaneId!)));
        if (r?.OrderCompleted == true) Notifications.Info($"Order {r.OrderId} is complete: the case in lane {r.LaneId} runs out to the packing operator.");
        await LoadAsync();
    }

    private Task CompleteTask(AsrsTaskDto t) => Do(sp => sp.Get<AsrsService>().CompleteTaskAsync(t.Id), $"R1: {t.Kind.Words()} of bin {t.BinId} done.");

    private Task CancelTask(AsrsTaskDto t) => Do(sp => sp.Get<AsrsService>().CancelTaskAsync(t.Id), $"R1 task {t.Id} cancelled.");

    private Task Missed(BeltItemDto i) =>
        Do(sp => sp.Get<SortationService>().ReportMissedAsync(i.PickTaskId), $"Carton #{i.PickTaskId} ran off the belt into the exception tote.");

    private Task ToggleLane(LaneDto l) =>
        Do(sp => sp.Get<PutWallService>().SetEnabledAsync(l.Id, l.Disabled), l.Disabled ? $"Lane {l.Id} enabled." : $"Lane {l.Id} takes no new orders.");

    private Task EmptyTote() => Do(sp => sp.Get<ExceptionService>().EmptyToteAsync(), "Exception tote emptied.");

    private Task Lane(LaneDto l, LaneEvent e) => Do(sp => sp.Get<PutWallService>().AdvanceAsync(l.Id, e), null);

    private RefillForm Refill(string binId, RestockBinDto r)
    {
        if (!refills.TryGetValue(binId, out var f)) refills[binId] = f = new RefillForm { Quantity = r.Capacity, Sku = r.SkuCode };
        return f;
    }

    private async Task DoRestock(RestockBinDto r, RefillForm f)
    {
        var bin = await Wms.CommandAsync(sp => sp.Get<RestockService>().CompleteAsync(r.BinId, new RestockRequest(f.Quantity, f.Sku, "console")));
        if (bin is not null)
        {
            refills.Remove(r.BinId);
            Notifications.Info($"Bin {bin.Id} refilled to {bin.Quantity} × {bin.SkuCode}; it waits for R1 at the restock-loop return head.");
        }
        await LoadAsync();
    }

    private Task Resolve(ExceptionItemDto e, ExceptionDisposition d) =>
        Do(sp => sp.Get<ExceptionService>().ResolveAsync(e.Id, new ResolveExceptionRequest(d, "console")), $"Exception {e.Id}: {d.Words()}.");

    [Inject] private Notifications Notifications { get; set; } = null!;
}
