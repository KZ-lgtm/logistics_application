@page "/operations"
@inherits WmsPage
@inject SimulationRunner Sim
<PageTitle>@L["Cell operations · Logistics WMS"]</PageTitle>
<PageHeader Title="@L["Cell operations"]" />

<div class="content">
    <p class="muted" style="margin: 0">
        @L["This console plays the cell controller and the operators by hand: every button is one WMS call, the same calls the cell (or the simulator) makes. Work through the flow from left to right: R1 → picking loop → stops → belt & arch → sorters → put wall."]
        @if (Sim.Running) { <span class="warn">@L["The simulator is running and will act on the same items. Stop it to work by hand."]</span> }
    </p>
    @if (Sim.TwinActive)
    {
        <div class="banner">@L["The live 3D cell is the cell controller now: it books these events itself, so the buttons here are locked."] <a href="live">@L["Go to the 3D cell"]</a> @L["or stop it there to work by hand."]</div>
    }

    <fieldset class="ops" disabled="@Sim.TwinActive">
    <div class="grid">
        <!-- R1 -->
        <section class="card span-4 stack">
            <h2>@L["1 · R1 in the cylinder shelf"]</h2>
            @if (task is { } t)
            {
                <div class="task">
                    <b>@L.Enum(t.Kind)</b> · @L.F("bin {0}", t.BinId) <span class="muted">(@t.SkuCode, @L.F("{0} pcs", t.BinQuantity))</span>
                    <div class="small muted">@L.Message(t.From) → @L.Message(t.To)</div>
                </div>
                <div class="row">
                    <button class="primary" @onclick="() => CompleteTask(t)">@L["Task done"]</button>
                    <button class="danger" @onclick="() => CancelTask(t)">@L["Cancel task"]</button>
                </div>
            }
            else
            {
                <div class="muted">@L["R1 has no task."]</div>
                <div><button class="primary" @onclick="NextTask">@L["Request next task"]</button></div>
            }
            <div class="small muted">@L["Order of work: returning bins, refilled bins, retrievals for open demand, empty bins to restock."]</div>
        </section>

        <!-- picking loop -->
        <section class="card span-4 stack">
            <h2>@L["2 · Picking loop"]</h2>
            @if (inbound.Count == 0)
            {
                <div class="empty">@L["No bin on the way to a stop."]</div>
            }
            @foreach (var b in inbound)
            {
                <div class="stop row">
                    <span><b>@b.Id</b> · @b.SkuCode · @L.F("{0} pcs", b.Quantity)</span>
                    <span class="spacer"></span>
                    @if (b.Station is null)
                    {
                        <button @onclick="() => Route(b.Id)">@L["Decision point"]</button>
                    }
                    else
                    {
                        <span class="pill s-AtStation">→ @b.Station</span>
                        <button class="primary" disabled="@(stations.Any(s => s.Station == b.Station && s.BinId is not null))" @onclick="() => Arrive(b.Id, b.Station.Value)">@L["Arrived"]</button>
                    }
                </div>
            }
            <div class="small muted">@L["At the decision point the WMS sends the bin to P2, else P1, or back if its SKU is no longer needed."]</div>
        </section>

        <!-- stops -->
        <section class="card span-4 stack">
            <h2>@L["3 · Picking stops (R2 / R3)"]</h2>
            @foreach (var st in stations)
            {
                <div class="stop stack">
                    <div class="row"><b>@st.Station</b>
                        @if (st.BinId is null) { <span class="muted">@L["no bin"]</span> }
                        else { <span>@L.F("bin {0}", st.BinId) · @st.SkuCode · <b>@st.BinQuantity</b> @L["pcs"]</span> }
                    </div>
                    @if (st.BinId is not null)
                    {
                        @foreach (var p in st.Picks.Take(4))
                        {
                            <div class="row small">
                                <span>#@p.Sequence → @L.F("order {0}", p.OrderId) <span class="muted">(@p.OrderReference)</span></span>
                                <span class="spacer"></span>
                                @if (p == st.Picks[0])
                                {
                                    <button class="sm primary" @onclick="() => Do(sp => sp.Get<PickingService>().ConfirmPickAsync(p.PickTaskId), null)">@L["Picked onto belt"]</button>
                                }
                            </div>
                        }
                        @if (st.Picks.Count > 4) { <div class="small muted">… @L.F("{0} more", st.Picks.Count - 4)</div> }
                        <div class="row small">
                            <span class="muted">@L["3D image counts"]</span>
                            <input type="number" min="0" @bind="counts[st.Station]" />
                            <button class="sm" @onclick="() => Count(st)">@L["Correct count"]</button>
                        </div>
                    }
                </div>
            }
        </section>

        <!-- belt -->
        <section class="card span-6">
            <div class="card-head"><h2>@L["4 · Item belt, bar-code arch, sorters (S1 / S2)"]</h2><span class="muted small">@L.F("{0} on the belt", belt.Count)</span></div>
            @if (belt.Count == 0)
            {
                <div class="empty">@L["The belt is empty."]</div>
            }
            else
            {
                <div class="table-wrap" style="max-height: 320px">
                    <table>
                        <thead><tr><th>@L["Carton"]</th><th>@L["SKU"]</th><th>@L["Order"]</th><th>@L["Status"]</th><th></th></tr></thead>
                        <tbody>
                            @foreach (var i in belt)
                            {
                                <tr>
                                    <td>#@i.PickTaskId</td>
                                    <td>@i.SkuCode</td>
                                    <td>@i.OrderId</td>
                                    <td>@if (i.Status == PickStatus.Routed) { <span class="pill s-Routed">→ @i.TargetSorter · @i.TargetLaneId</span> } else { <span class="pill s-Pending">@L["not scanned"]</span> }</td>
                                    <td class="r">
                                        @if (i.Status == PickStatus.OnBelt)
                                        {
                                            <button class="sm primary" @onclick="() => Scan(i, i.SkuCode)">@L["Scan"]</button>
                                            <button class="sm" @onclick="() => Scan(i, null)" title="@L["The arch could not read the bar code"]">@L["No read"]</button>
                                            <button class="sm" @onclick="() => Scan(i, WrongCode(i.SkuCode))" title="@L["The arch read another SKU's bar code"]">@L["Wrong code"]</button>
                                        }
                                        else
                                        {
                                            <button class="sm primary" @onclick="() => Sort(i)">@L.F("Put into {0}", i.TargetLaneId)</button>
                                            <button class="sm" @onclick="() => Missed(i)" title="@L["The sorter did not take it: it runs off the belt into the exception tote"]">@L["Missed"]</button>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>

        <!-- put wall -->
        <section class="card span-6">
            <h2>@L["5 · Put wall & packing operator"]</h2>
            <div class="lanes">
                @foreach (var l in lanes)
                {
                    <div class="lane">
                        <div class="head">@l.Id <StatusPill Value="l.State" Label="@(l.Disabled ? L["disabled"] : null)" /></div>
                        <div class="muted small">@(l.OrderId is null ? L["no order"] : L.F("order {0} · {1}/{2}", l.OrderId, l.SortedItems, l.OrderItems))</div>
                        @switch (l.State)
                        {
                            case LaneState.Outbound: <button class="sm primary" @onclick="() => Lane(l, LaneEvent.CaseAtOperator)">@L["At operator"]</button> break;
                            case LaneState.AtOperator: <button class="sm primary" @onclick="() => Lane(l, LaneEvent.CaseReplaced)">@L["Packed, new case"]</button> break;
                            case LaneState.Inbound: <button class="sm primary" @onclick="() => Lane(l, LaneEvent.EmptyCaseInPosition)">@L["Case in place"]</button> break;
                            default:
                                <button class="sm ghost" @onclick="() => ToggleLane(l)">@(l.Disabled ? L["Enable"] : L["Disable"])</button>
                                break;
                        }
                    </div>
                }
            </div>
        </section>

        <!-- restock -->
        <section class="card span-6 stack">
            <h2>@L["6 · Restock operator (west port)"]</h2>
            @if (restock.Count == 0)
            {
                <div class="empty">@L["No bin at the restock station. R1 sends empty bins here."]</div>
            }
            @foreach (var r in restock)
            {
                var f = Refill(r.BinId, r);
                <div class="stop row">
                    <span><b>@r.BinId</b> · @r.SkuCode · @r.Quantity / @L.F("{0} pcs", r.Capacity) @if (r.BufferAvailable > 0) { <span class="pill s-Open">@L.F("{0} from exceptions", r.BufferAvailable)</span> }</span>
                    <span class="spacer"></span>
                    <label class="small">@L["fill to"] <input type="number" min="0" @bind="f.Quantity" /></label>
                    @if (r.Quantity == 0)
                    {
                        <select class="small" @bind="f.Sku" title="@L["An empty bin can take another SKU"]">
                            @foreach (var s in skus) { <option value="@s.Code">@s.Code</option> }
                        </select>
                    }
                    <button class="sm primary" @onclick="() => DoRestock(r, f)">@L["Done"]</button>
                </div>
            }
        </section>

        <!-- exceptions -->
        <section class="card span-6 stack">
            <div class="card-head">
                <h2>@L["7 · Exception tote"]</h2>
                <button class="sm" @onclick="EmptyTote">@L["Tote emptied"]</button>
            </div>
            @if (exceptions.Count == 0)
            {
                <div class="empty">@L["No open exceptions."]</div>
            }
            else
            {
                <div class="table-wrap" style="max-height: 260px">
                    <table>
                        <thead><tr><th>#</th><th>@L["SKU"]</th><th>@L["Order"]</th><th>@L["Reason"]</th><th></th></tr></thead>
                        <tbody>
                            @foreach (var e in exceptions)
                            {
                                <tr>
                                    <td>@e.Id</td><td>@e.SkuCode</td><td>@e.OrderId</td>
                                    <td>@L.Enum(e.Reason) @if (e.ReadBarcode is not null) { <span class="muted">(@L.F("read {0}", e.ReadBarcode))</span> }</td>
                                    <td class="r">
                                        <button class="sm" @onclick="() => Resolve(e, ExceptionDisposition.ReturnedToStock)">@L["Return to stock"]</button>
                                        <button class="sm danger" @onclick="() => Resolve(e, ExceptionDisposition.Scrapped)">@L["Scrap"]</button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>
    </div>
    </fieldset>
</div>

@code {
    private sealed class RefillForm { public int Quantity { get; set; } public string Sku { get; set; } = ""; }

    private AsrsTaskDto? task;
    private IReadOnlyList<BinDto> inbound = [];
    private IReadOnlyList<StationDto> stations = [];
    private IReadOnlyList<BeltItemDto> belt = [];
    private IReadOnlyList<LaneDto> lanes = [];
    private IReadOnlyList<RestockBinDto> restock = [];
    private IReadOnlyList<ExceptionItemDto> exceptions = [];
    private IReadOnlyList<SkuStockDto> skus = [];
    private readonly Dictionary<PickStation, int> counts = new() { [PickStation.P1] = 0, [PickStation.P2] = 0 };
    private readonly Dictionary<string, RefillForm> refills = [];

    protected override async Task OnInitializedAsync()
    {
        skus = await Wms.QueryAsync(sp => sp.Get<InventoryService>().GetStockAsync());
        await base.OnInitializedAsync();
    }

    protected override async Task LoadAsync()
    {
        (task, inbound, stations, belt, lanes, restock, exceptions) = await Wms.QueryAsync(async sp => (
            await sp.Get<AsrsService>().GetCurrentTaskAsync(),
            await sp.Get<InventoryService>().ListBinsAsync(null, BinLocation.PickInbound),
            (IReadOnlyList<StationDto>)[await sp.Get<PickingService>().GetStationAsync(PickStation.P1), await sp.Get<PickingService>().GetStationAsync(PickStation.P2)],
            await sp.Get<SortationService>().ListOnBeltAsync(),
            await sp.Get<PutWallService>().ListAsync(),
            await sp.Get<RestockService>().ListAsync(),
            await sp.Get<ExceptionService>().ListAsync(openOnly: true, take: 100)));
        foreach (var st in stations)
            if (st.BinId is not null && !countsFor.Contains($"{st.Station}:{st.BinId}")) { counts[st.Station] = st.BinQuantity; countsFor.Add($"{st.Station}:{st.BinId}"); }
    }

    private readonly HashSet<string> countsFor = [];

    private async Task Do<T>(Func<IServiceProvider, Task<T>> command, string? success)
    {
        await Wms.CommandAsync(command, success);
        await LoadAsync();
    }

    private async Task NextTask()
    {
        var t = await Wms.CommandAsync(sp => sp.Get<AsrsService>().RequestNextTaskAsync());
        if (t is null) Notifications.Info(L["R1 has nothing to do: no returning bin, no open demand, no empty bin to restock."]);
        await LoadAsync();
    }

    private async Task Route(string binId)
    {
        var r = await Wms.CommandAsync(sp => sp.Get<PickingService>().RouteBinAsync(binId));
        if (r is not null)
            Notifications.Info(r.Decision switch
            {
                RouteDecision.Station => L.F("Bin {0} → stop {1} ({2} pcs open demand).", binId, r.Station, r.OpenDemand),
                RouteDecision.Return => L.F("Bin {0} is not needed any more and goes back to the return head.", binId),
                _ => L.F("Both stops are busy: bin {0} waits at the decision point.", binId),
            });
        await LoadAsync();
    }

    private async Task Arrive(string binId, PickStation station)
    {
        var st = await Wms.CommandAsync(sp => sp.Get<PickingService>().ArriveAtStationAsync(binId, station));
        if (st is not null)
            Notifications.Info(st.BinId is null ? L.F("Bin {0} has nothing to pick any more and was released.", binId) : L.F("Bin {0} at {1}: {2} picks allocated.", binId, station, st.Picks.Count));
        await LoadAsync();
    }

    private Task Count(StationDto st) =>
        Do(sp => sp.Get<PickingService>().ReportBinCountAsync(st.BinId!, new BinCountRequest(counts[st.Station], "console")), L.F("Bin {0} corrected to {1} pcs.", st.BinId, counts[st.Station]));

    private async Task Scan(BeltItemDto i, string? barcode)
    {
        var r = await Wms.CommandAsync(sp => sp.Get<SortationService>().ScanAsync(new ScanRequest(i.PickTaskId, barcode)));
        if (r is not null)
        {
            if (r.Target == ScanTarget.Exception) Notifications.Error(L.F("Carton #{0} → exception tote ({1}); the order line is fetched again.", i.PickTaskId, r.ExceptionReason is { } why ? L.Enum(why) : ""));
            else Notifications.Info(L.F("Carton #{0} → {1}, lane {2}.", i.PickTaskId, r.Target, r.LaneId));
        }
        await LoadAsync();
    }

    private string WrongCode(string code) => skus.FirstOrDefault(s => s.Code != code)?.Code ?? "SKU-0000";

    private async Task Sort(BeltItemDto i)
    {
        var r = await Wms.CommandAsync(sp => sp.Get<SortationService>().ConfirmSortAsync(new SortConfirmRequest(i.PickTaskId, i.TargetLaneId!)));
        if (r?.OrderCompleted == true) Notifications.Info(L.F("Order {0} is complete: the case in lane {1} runs out to the packing operator.", r.OrderId, r.LaneId));
        await LoadAsync();
    }

    private Task CompleteTask(AsrsTaskDto t) => Do(sp => sp.Get<AsrsService>().CompleteTaskAsync(t.Id), L.F("R1: {0} of bin {1} done.", L.Enum(t.Kind), t.BinId));

    private Task CancelTask(AsrsTaskDto t) => Do(sp => sp.Get<AsrsService>().CancelTaskAsync(t.Id), L.F("R1 task {0} cancelled.", t.Id));

    private Task Missed(BeltItemDto i) =>
        Do(sp => sp.Get<SortationService>().ReportMissedAsync(i.PickTaskId), L.F("Carton #{0} ran off the belt into the exception tote.", i.PickTaskId));

    private Task ToggleLane(LaneDto l) =>
        Do(sp => sp.Get<PutWallService>().SetEnabledAsync(l.Id, l.Disabled), l.Disabled ? L.F("Lane {0} enabled.", l.Id) : L.F("Lane {0} takes no new orders.", l.Id));

    private Task EmptyTote() => Do(sp => sp.Get<ExceptionService>().EmptyToteAsync(), L["Exception tote emptied."]);

    private Task Lane(LaneDto l, LaneEvent e) => Do(sp => sp.Get<PutWallService>().AdvanceAsync(l.Id, e), null);

    private RefillForm Refill(string binId, RestockBinDto r)
    {
        if (!refills.TryGetValue(binId, out var f)) refills[binId] = f = new RefillForm { Quantity = r.Capacity, Sku = r.SkuCode };
        return f;
    }

    private async Task DoRestock(RestockBinDto r, RefillForm f)
    {
        var bin = await Wms.CommandAsync(sp => sp.Get<RestockService>().CompleteAsync(r.BinId, new RestockRequest(f.Quantity, f.Sku, "console")));
        if (bin is not null)
        {
            refills.Remove(r.BinId);
            Notifications.Info(L.F("Bin {0} refilled to {1} × {2}; it waits for R1 at the restock-loop return head.", bin.Id, bin.Quantity, bin.SkuCode));
        }
        await LoadAsync();
    }

    private Task Resolve(ExceptionItemDto e, ExceptionDisposition d) =>
        Do(sp => sp.Get<ExceptionService>().ResolveAsync(e.Id, new ResolveExceptionRequest(d, "console")), L.F("Exception {0}: {1}.", e.Id, L.Enum(d)));

    [Inject] private Notifications Notifications { get; set; } = null!;
}
