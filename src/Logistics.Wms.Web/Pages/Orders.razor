@page "/orders"
@inherits WmsPage
@inject TwinService Twin
<PageTitle>@L["Orders · Logistics WMS"]</PageTitle>
<PageHeader Title="@L["Orders"]" />

<div class="content">
    <section class="card">
        <h2>@L["New order"]</h2>
        @if (Twin.Started)
        {
            <p class="small muted" style="margin: -4px 0 10px"><span class="dot ok"></span> @L["The live 3D cell is running: a new order is released to the put wall as soon as a lane has an empty case and is worked there."] <a href="live">@L["Watch it"]</a></p>
        }
        <div class="form-grid" style="grid-template-columns: minmax(160px, 1fr) 110px">
            <div class="field"><span>@L["Reference"]</span><input @bind="reference" placeholder="@L["e.g. SHOP-10045"]" /></div>
            <div class="field"><span>@L["Priority"]</span><input type="number" @bind="priority" title="@L["Higher priorities are released to the put wall first"]" /></div>
        </div>
        <div class="stack" style="margin-top: 10px">
            @for (var i = 0; i < lines.Count; i++)
            {
                var line = lines[i];
                <div class="line-row">
                    <select @bind="line.Sku" aria-label="@L["SKU"]">
                        @foreach (var s in skus)
                        {
                            <option value="@s.Code">@s.Code · @L.Message(s.Name) (@L.F("{0} in stock", s.Total))</option>
                        }
                    </select>
                    <input type="number" min="1" @bind="line.Quantity" aria-label="@L["Quantity"]" />
                    <button class="ghost" disabled="@(lines.Count == 1)" @onclick="() => lines.Remove(line)" aria-label="@L["Remove line"]">✕</button>
                </div>
            }
            <div class="row">
                <button disabled="@(lines.Count >= OrderService.MaxLinesPerOrder)" @onclick="AddLine">@L["+ Line"]</button>
                <span class="spacer"></span>
                <span class="muted small">@L.F("Up to {0} SKUs per order case · same SKUs are merged", OrderService.MaxLinesPerOrder)</span>
                <button class="primary" disabled="@busy" @onclick="Create">@L["Create order"]</button>
            </div>
        </div>
    </section>

    <section class="card">
        <div class="card-head">
            <div class="tabs" style="margin: 0; border: 0">
                @foreach (var f in Filters)
                {
                    <button class="@(filter == f ? "on" : "")" @onclick="() => SetFilter(f)">@(f is null ? L["All"] : L.Enum(f))</button>
                }
            </div>
            <span class="muted small">@L.F("newest {0} shown", Take)</span>
        </div>
        @if (orders.Count == 0)
        {
            <div class="empty">@L["No orders."]</div>
        }
        else
        {
            <div class="table-wrap tall">
                <table>
                    <thead><tr><th>#</th><th>@L["Reference"]</th><th>@L["Status"]</th><th>@L["Prio"]</th><th>@L["Lane"]</th><th class="r">@L["Sorted"]</th><th>@L["Created"]</th><th>@L["Lines"]</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var o in orders)
                        {
                            <tr class="@(open == o.Id ? "sel" : "")" @onclick="() => open = open == o.Id ? null : o.Id" style="cursor: pointer">
                                <td>@o.Id</td>
                                <td>@o.Reference</td>
                                <td><StatusPill Value="o.Status" /></td>
                                <td>@o.Priority</td>
                                <td>@o.LaneId</td>
                                <td class="r">@o.SortedQuantity / @o.TotalQuantity</td>
                                <td class="muted">@Fmt.Time(o.CreatedAt)</td>
                                <td class="muted">@string.Join(", ", o.Lines.Select(l => $"{l.SkuCode}×{l.Quantity}"))</td>
                                <td class="r">
                                    @if (o.Status is OrderStatus.Queued or OrderStatus.Active)
                                    {
                                        <a class="btn sm" href="live?order=@o.Id" @onclick:stopPropagation title="@L["Watch this order in the live 3D cell"]">@L["Watch in 3D"]</a>
                                    }
                                    @if (o.Status == OrderStatus.Queued || (o.Status == OrderStatus.Active && o.Lines.All(l => l.Picked == 0)))
                                    {
                                        <button class="sm danger" @onclick:stopPropagation @onclick="() => Cancel(o)">@L["Cancel"]</button>
                                    }
                                </td>
                            </tr>
                            @if (open == o.Id)
                            {
                                <tr>
                                    <td></td>
                                    <td colspan="8">
                                        <table>
                                            <thead><tr><th>@L["SKU"]</th><th class="r">@L["Ordered"]</th><th class="r">@L["Allocated"]</th><th class="r">@L["Picked"]</th><th class="r">@L["Sorted"]</th></tr></thead>
                                            <tbody>
                                                @foreach (var l in o.Lines)
                                                {
                                                    <tr><td>@l.SkuCode</td><td class="r">@l.Quantity</td><td class="r">@l.Allocated</td><td class="r">@l.Picked</td><td class="r">@l.Sorted</td></tr>
                                                }
                                            </tbody>
                                        </table>
                                        <div class="small muted" style="padding: 6px 0">
                                            @L.F("Released {0} · finished {1}", Fmt.Time(o.ActivatedAt), Fmt.Time(o.CompletedAt))
                                            @if (o.ActivatedAt is DateTime a && o.CompletedAt is DateTime c) { <span> · @L.F("lead time {0} s", (c - a).TotalSeconds.ToString("F0"))</span> }
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>
</div>

@code {
    private const int Take = 200;
    private static readonly OrderStatus?[] Filters = [null, OrderStatus.Queued, OrderStatus.Active, OrderStatus.Completed, OrderStatus.Cancelled];
    private sealed class Line { public string Sku { get; set; } = ""; public int Quantity { get; set; } = 1; }

    private IReadOnlyList<SkuStockDto> skus = [];
    private IReadOnlyList<OrderDto> orders = [];
    private readonly List<Line> lines = [];
    private OrderStatus? filter;
    private int? open;
    private string reference = NewReference();
    private int priority;
    private bool busy;

    protected override async Task OnInitializedAsync()
    {
        skus = await Wms.QueryAsync(sp => sp.Get<InventoryService>().GetStockAsync());
        AddLine();
        await base.OnInitializedAsync();
    }

    protected override async Task LoadAsync() =>
        orders = await Wms.QueryAsync(sp => sp.Get<OrderService>().ListAsync(filter, 0, Take));

    private static string NewReference() => $"WEB-{DateTime.Now:yyMMdd-HHmmss}";

    private void AddLine() => lines.Add(new Line { Sku = skus.Skip(lines.Count).FirstOrDefault()?.Code ?? skus.FirstOrDefault()?.Code ?? "" });

    private async Task SetFilter(OrderStatus? f)
    {
        filter = f;
        await LoadAsync();
    }

    private async Task Create()
    {
        busy = true;
        var request = new CreateOrderRequest(reference, [.. lines.Select(l => new CreateOrderLineRequest(l.Sku, l.Quantity))], priority);
        var order = await Wms.CommandAsync(sp => sp.Get<OrderService>().CreateAsync(request));
        if (order is not null)
        {
            reference = NewReference();
            lines.Clear();
            AddLine();
            open = order.Id;
            Notify(order.LaneId is null ? L.F("Order {0} ({1}) created, queued until a lane is free.", order.Id, order.Reference)
                                        : L.F("Order {0} ({1}) created, released to lane {2}.", order.Id, order.Reference, order.LaneId));
        }
        busy = false;
        await LoadAsync();
    }

    private async Task Cancel(OrderDto o)
    {
        await Wms.CommandAsync(sp => sp.Get<OrderService>().CancelAsync(o.Id), L.F("Order {0} cancelled.", o.Id));
        await LoadAsync();
    }

    [Inject] private Notifications Notifications { get; set; } = null!;
    private void Notify(string text) => Notifications.Info(text);
}
