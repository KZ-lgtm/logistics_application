{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Wms": "Data Source=wms.db"
  },
  "Simulation": {
    "Enabled": false,
    "StepMilliseconds": 500,
    "GenerateOrders": true,
    "QueueTarget": 12,
    "MaxLinesPerOrder": 4,
    "MaxQuantityPerLine": 3,
    "ParetoDemand": true,
    "NoReadRate": 0.005,
    "Seed": 7
  }
}
